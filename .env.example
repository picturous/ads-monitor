# Multi-Platform Ads Monitor Configuration
# Copy to .env and fill in the platforms you want to monitor.
# Platforms without credentials are automatically skipped (shown as "Not configured").

# --- Global ---
# ADS_MONITOR_DAYS=30
# ADS_MONITOR_WORKERS=8
# ADS_MONITOR_TIMEOUT_SECS=30

# --- Global Feature Toggles (true / false; default: true) ---
# Disable campaigns & spend if your tokens only have audience permissions.
# ADS_MONITOR_ENABLE_AUDIENCES=true
# ADS_MONITOR_ENABLE_CAMPAIGNS=true

# --- Global Audience Name Filter (comma-separated case-insensitive substrings) ---
# Only audiences whose name (or description) matches any term are loaded & expanded.
# Example: ADS_MONITOR_AUDIENCE_FILTER=LINEBKUSERS_,CreditLine_,VIP_
# ADS_MONITOR_AUDIENCE_FILTER=

# --- 1. OpenAI Ads ---
# OPENAI_API_KEY=sk-...
# OPENAI_ADS_BASE_URL=https://api.ads.openai.com/v1
# OPENAI_ENABLE_AUDIENCES=true
# OPENAI_AUDIENCE_FILTER=

# --- 2. Facebook / Meta Ads (Marketing Graph API) ---
# META_ACCESS_TOKEN=EAAG...
# META_AD_ACCOUNT_ID=1234567890          # with or without "act_" prefix; comma-separated supported
# META_API_VERSION=v25.0
# META_BASE_URL=https://graph.facebook.com
# META_ENABLE_AUDIENCES=true
# META_ENABLE_CAMPAIGNS=true
# META_AUDIENCE_FILTER=

# --- 3. Google Ads API ---
# GOOGLE_ADS_CUSTOMER_ID=1234567890      # 10-digit ID (dashes stripped automatically)
# GOOGLE_ADS_DEVELOPER_TOKEN=your_dev_token
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=9876543210  # optional MCC manager account ID
# Provide either a direct access token OR OAuth2 refresh credentials:
# GOOGLE_ADS_ACCESS_TOKEN=ya29....
# GOOGLE_ADS_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=GOCSPX-...
# GOOGLE_ADS_REFRESH_TOKEN=1//...
# GOOGLE_ADS_API_VERSION=v20
# GOOGLE_ADS_BASE_URL=https://googleads.googleapis.com
# GOOGLE_ADS_ENABLE_AUDIENCES=true
# GOOGLE_ADS_ENABLE_CAMPAIGNS=true
# GOOGLE_ADS_AUDIENCE_FILTER=

# --- 4. TikTok Ads (Marketing API v1.3) ---
# TIKTOK_ACCESS_TOKEN=your_access_token
# TIKTOK_ADVERTISER_ID=7000000000000000000
# TIKTOK_BC_ID=                          # optional Business Center ID for wallet balance
# TIKTOK_BASE_URL=https://business-api.tiktok.com
# TIKTOK_ENABLE_AUDIENCES=true
# TIKTOK_ENABLE_CAMPAIGNS=false          # set false if token only has DMP audience scope
# TIKTOK_AUDIENCE_FILTER=

# --- 5. LINE Official Account (LINE Messaging API) ---
# Method A (Recommended): Stateless 15-min token auto-issued & refreshed via /oauth2/v3/token:
# LINE_OA_CHANNEL_ID=1234567890
# LINE_OA_CHANNEL_SECRET=your_channel_secret
# Method B: Static channel access token (used if channel ID + secret are not set):
# LINE_OA_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token
# LINE_OA_BASE_URL=https://api.line.me
# LINE_OA_ENABLE_AUDIENCES=true
# LINE_OA_ENABLE_CAMPAIGNS=true          # controls quota/followers/delivery insights
# LINE_OA_AUDIENCE_FILTER=

# --- 6. LINE Ads API v3 ---
# LINE_ADS_ACCESS_KEY=your_access_key
# LINE_ADS_SECRET_KEY=your_secret_key
# LINE_ADS_ACCOUNT_ID=A1234567890
# LINE_ADS_BASE_URL=https://ads.line.me
# LINE_ADS_ENABLE_AUDIENCES=true
# LINE_ADS_ENABLE_CAMPAIGNS=false        # set false if key only has custom-audiences scope
# LINE_ADS_AUDIENCE_FILTER=
